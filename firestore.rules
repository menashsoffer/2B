rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isHouseholdMember(hid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(hid)) &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    // A resumable deletion freezes writers before draining collections, avoiding orphan races.
    function isHouseholdWritable(hid) {
      return isHouseholdMember(hid) &&
        get(/databases/$(database)/documents/households/$(hid)).data.get('deleting', false) == false;
    }

    // --- Validation Helpers ---

    function isValidHousehold(data) {
      return (!('deleting' in data) || data.deleting is bool) &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() <= 10 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 120)) &&
             (!('partnerEmail' in data) || (data.partnerEmail is string && data.partnerEmail.size() <= 120)) &&
             (!('partnerUid' in data) || (data.partnerUid is string && data.partnerUid.size() <= 128));
    }

    function isValidInboxItem(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             data.userId is string;
    }

    function isValidDreamItem(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.list is string && data.list.size() <= 100 &&
             data.userId is string;
    }

    function isValidTaskItem(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.userId is string;
    }

    function isValidFitnessLog(data) {
      return data.date is string && data.date.size() <= 20 &&
             data.moved is bool &&
             data.userId is string && data.userId == request.auth.uid;
    }

    function isValidCalculatorSync(data) {
      return data.calculatorType is string && data.calculatorType.size() <= 50 &&
             data.dataJson is string && data.dataJson.size() <= 100000 &&
             data.userId is string && data.userId == request.auth.uid;
    }

    // Money pillar: fully shared inside the household. Document id = engine id.
    function isMoneyCollection(name) {
      return name in ['cards', 'incomes', 'fixedExpenses', 'subscriptions', 'variableBudgets',
                      'installments', 'periodicBudgets', 'debts', 'savings', 'assets', 'categories',
                      'transactions', 'merchantMemory', 'goals', 'donations', 'tithe', 'closedMonths', 'pensionFunds', 'car'];
    }

    // One validator per money collection, generated from and tested against the app's own writers:
    // firestore-fixtures/money holds what the writers produce (MoneyFixturesTest keeps it in sync) and
    // firestore.test.js requires every fixture to be accepted. Change a writer -> re-record -> update here.
    // "v" (schema version) is optional: documents from app versions before it have none.

    function isAgorot(x) {
      return x is int && x >= -10000000000 && x <= 10000000000;
    }

    function isName(x) {
      return x is string && x.size() > 0 && x.size() <= 200;
    }

    function isText(x, max) {
      return x is string && x.size() <= max;
    }

    function isRef(x) {
      return x is string && x.size() > 0 && x.size() <= 128;
    }

    function isMonth(x) {
      return x is string && x.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isDate(x) {
      return x is string && x.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isDecimal(x) {
      return x is string && x.matches('^-?[0-9]{1,9}([.][0-9]{1,12})?$');
    }

    function isIntIn(x, low, high) {
      return x is int && x >= low && x <= high;
    }

    function isClass(x) {
      return x in ['FIXED', 'CURRENT', 'PERIODIC'];
    }

    function isMapUpTo(x, max) {
      return x is map && x.size() <= max;
    }

    function isListUpTo(x, max) {
      return x is list && x.size() <= max;
    }

    // AmountHistory: {changes: [{from, amount}], overrides: {"yyyy-MM": agorot}}
    function isHistory(h) {
      return h is map && h.keys().hasOnly(['changes', 'overrides']) &&
             (!('changes' in h) || isListUpTo(h.changes, 600)) &&
             (!('overrides' in h) || isMapUpTo(h.overrides, 600));
    }

    function hasValidVersion(data) {
      return !('v' in data) || isIntIn(data.v, 1, 100);
    }

    function optRef(data, key) {
      return !(key in data) || isRef(data[key]);
    }

    function isValidCard(d) {
      return d.keys().hasOnly(['name', 'billingDay', 'v']) && d.keys().hasAll(['name', 'billingDay']) &&
             isName(d.name) && isIntIn(d.billingDay, 1, 31);
    }

    function isValidIncome(d) {
      return d.keys().hasOnly(['name', 'amounts', 'titheRate', 'v']) && d.keys().hasAll(['name', 'amounts', 'titheRate']) &&
             isName(d.name) && isHistory(d.amounts) && d.titheRate in ['NONE', 'MAASER', 'CHOMESH'];
    }

    function isValidFixedExpense(d) {
      return d.keys().hasOnly(['name', 'amounts', 'frequency', 'klass', 'cardId', 'billingMonth', 'categoryId', 'v']) &&
             d.keys().hasAll(['name', 'amounts', 'frequency', 'klass']) &&
             isName(d.name) && isHistory(d.amounts) && d.frequency in ['MONTHLY', 'YEARLY'] && isClass(d.klass) &&
             optRef(d, 'cardId') && optRef(d, 'categoryId') &&
             (!('billingMonth' in d) || isIntIn(d.billingMonth, 1, 12));
    }

    function isValidSubscription(d) {
      return d.keys().hasOnly(['name', 'amounts', 'currency', 'frequency', 'renewalDate', 'klass', 'cardId', 'categoryId', 'v']) &&
             d.keys().hasAll(['name', 'amounts', 'currency', 'frequency', 'renewalDate', 'klass']) &&
             isName(d.name) && isHistory(d.amounts) && d.currency in ['ILS', 'USD'] &&
             d.frequency in ['MONTHLY', 'YEARLY'] && isDate(d.renewalDate) && isClass(d.klass) &&
             optRef(d, 'cardId') && optRef(d, 'categoryId');
    }

    function isValidVariableBudget(d) {
      return d.keys().hasOnly(['name', 'amounts', 'klass', 'cardId', 'categoryId', 'v']) &&
             d.keys().hasAll(['name', 'amounts', 'klass']) &&
             isName(d.name) && isHistory(d.amounts) && isClass(d.klass) && optRef(d, 'cardId') && optRef(d, 'categoryId');
    }

    function isValidInstallment(d) {
      return d.keys().hasOnly(['name', 'total', 'currentMonth', 'numberOfPayments', 'firstMonth', 'cardId', 'v']) &&
             d.keys().hasAll(['name', 'total', 'currentMonth', 'numberOfPayments', 'firstMonth']) &&
             isName(d.name) && isAgorot(d.total) && isMonth(d.currentMonth) && isIntIn(d.numberOfPayments, 1, 1000) &&
             isMonth(d.firstMonth) && optRef(d, 'cardId');
    }

    function isValidPeriodicBudget(d) {
      return d.keys().hasOnly(['categoryId', 'name', 'annualAmount', 'yearStartMonth', 'v']) &&
             d.keys().hasAll(['categoryId', 'name', 'annualAmount', 'yearStartMonth']) &&
             isRef(d.categoryId) && isName(d.name) && isAgorot(d.annualAmount) && isMonth(d.yearStartMonth);
    }

    function isValidDebt(d) {
      return d.keys().hasOnly(['creditor', 'balance', 'asOf', 'annualInterestPercent', 'remainingPayments', 'monthlyPayment', 'v']) &&
             d.keys().hasAll(['creditor', 'balance', 'asOf', 'annualInterestPercent', 'remainingPayments', 'monthlyPayment']) &&
             isName(d.creditor) && isAgorot(d.balance) && isDate(d.asOf) && isDecimal(d.annualInterestPercent) &&
             isIntIn(d.remainingPayments, 0, 1200) && isAgorot(d.monthlyPayment);
    }

    function isValidSaving(d) {
      return d.keys().hasOnly(['name', 'monthlyDeposit', 'accumulated', 'maturity', 'v']) &&
             d.keys().hasAll(['name', 'monthlyDeposit', 'accumulated']) &&
             isName(d.name) && isAgorot(d.monthlyDeposit) && isAgorot(d.accumulated) &&
             (!('maturity' in d) || isMonth(d.maturity));
    }

    function isValidAsset(d) {
      return d.keys().hasOnly(['name', 'type', 'balance', 'kind', 'liquid', 'lastUpdated', 'v']) &&
             d.keys().hasAll(['name', 'type', 'balance', 'kind', 'liquid', 'lastUpdated']) &&
             isName(d.name) && isText(d.type, 100) && isAgorot(d.balance) && d.kind in ['ASSET', 'LIABILITY'] &&
             d.liquid is bool && isDate(d.lastUpdated);
    }

    function isValidCategory(d) {
      return d.keys().hasOnly(['name', 'klass', 'parentId', 'v']) && d.keys().hasAll(['name', 'klass']) &&
             isName(d.name) && isClass(d.klass) && optRef(d, 'parentId');
    }

    function isValidGoal(d) {
      return d.keys().hasOnly(['name', 'amount', 'targetMonth', 'allocated', 'newMonthlyCost', 'v']) &&
             d.keys().hasAll(['name', 'amount', 'targetMonth', 'allocated']) &&
             isName(d.name) && isAgorot(d.amount) && isMonth(d.targetMonth) && isAgorot(d.allocated) &&
             (!('newMonthlyCost' in d) || isAgorot(d.newMonthlyCost));
    }

    function isValidDonation(d) {
      return d.keys().hasOnly(['date', 'amount', 'organisation', 'submittedForTaxRefund', 'v']) &&
             d.keys().hasAll(['date', 'amount', 'organisation', 'submittedForTaxRefund']) &&
             isDate(d.date) && isAgorot(d.amount) && isText(d.organisation, 200) && d.submittedForTaxRefund is bool;
    }

    function isValidTithe(docId, d) {
      return docId == 'settings' &&
             d.keys().hasOnly(['startMonth', 'opening', 'portfolioAssetId', 'depositsBefore', 'v']) &&
             d.keys().hasAll(['startMonth', 'opening', 'depositsBefore']) &&
             isMonth(d.startMonth) && isAgorot(d.opening) && optRef(d, 'portfolioAssetId') && isAgorot(d.depositsBefore);
    }

    function isValidClosedMonth(docId, d) {
      return isMonth(docId) &&
             d.keys().hasOnly(['actualIncomes', 'actualExpenses', 'byCategory', 'periodic', 'balances', 'liabilities',
                               'closedOn', 'balancesEntered', 'v']) &&
             d.keys().hasAll(['actualIncomes', 'actualExpenses', 'byCategory', 'periodic', 'balances', 'liabilities', 'closedOn']) &&
             isAgorot(d.actualIncomes) && isAgorot(d.actualExpenses) &&
             isMapUpTo(d.byCategory, 500) && isMapUpTo(d.periodic, 500) &&
             isMapUpTo(d.balances, 500) && isMapUpTo(d.liabilities, 500) &&
             isDate(d.closedOn) && (!('balancesEntered' in d) || d.balancesEntered is bool);
    }

    function isValidCar(docId, d) {
      return docId == 'settings' &&
             d.keys().hasOnly(['categoryIds', 'horizonYears', 'included', 'fields', 'v']) &&
             d.keys().hasAll(['categoryIds', 'horizonYears', 'included', 'fields']) &&
             isListUpTo(d.categoryIds, 100) && isIntIn(d.horizonYears, 1, 50) &&
             isListUpTo(d.included, 10) && isMapUpTo(d.fields, 30);
    }

    function isValidPensionFund(d) {
      return d.keys().hasOnly(['kind', 'provider', 'value', 'totalDeposits', 'monthlyDeposit', 'feeOnBalance', 'feeOnDeposits',
                               'openedOn', 'lastUpdated', 'v']) &&
             d.keys().hasAll(['kind', 'provider', 'value', 'totalDeposits', 'monthlyDeposit', 'feeOnBalance', 'feeOnDeposits',
                              'lastUpdated']) &&
             d.kind in ['PENSION', 'HISHTALMUT', 'GEMEL'] && isText(d.provider, 200) &&
             isAgorot(d.value) && isAgorot(d.totalDeposits) && isAgorot(d.monthlyDeposit) &&
             isDecimal(d.feeOnBalance) && isDecimal(d.feeOnDeposits) &&
             (!('openedOn' in d) || isDate(d.openedOn)) && isDate(d.lastUpdated);
    }

    function isValidTransaction(d) {
      return d.keys().hasOnly(['source', 'sourceId', 'date', 'chargeDate', 'description', 'details', 'charge', 'originalAmount',
                               'originalCurrency', 'status', 'installmentNumber', 'installmentOf', 'hint', 'operation',
                               'categoryId', 'v']) &&
             d.keys().hasAll(['source', 'sourceId', 'date', 'description', 'originalCurrency', 'status']) &&
             d.source in ['HAPOALIM', 'ONE_ZERO', 'MAX', 'CAL'] && isText(d.sourceId, 200) && isDate(d.date) &&
             (!('chargeDate' in d) || isDate(d.chargeDate)) && isText(d.description, 1000) &&
             (!('details' in d) || isText(d.details, 1000)) &&
             (!('charge' in d) || isAgorot(d.charge)) && (!('originalAmount' in d) || isAgorot(d.originalAmount)) &&
             isText(d.originalCurrency, 10) && d.status in ['COUNTED', 'PENDING', 'WAITING_FX'] &&
             (!('installmentNumber' in d) || isIntIn(d.installmentNumber, 1, 1000)) &&
             (!('installmentOf' in d) || isIntIn(d.installmentOf, 1, 1000)) &&
             (!('hint' in d) || isText(d.hint, 1000)) && (!('operation' in d) || isText(d.operation, 1000)) &&
             optRef(d, 'categoryId');
    }

    function isValidMerchantMemory(d) {
      return d.keys().hasOnly(['key', 'categoryId', 'ownTransfer', 'alias', 'askEachTime', 'v']) && d.keys().hasAll(['key']) &&
             d.key is string && d.key.size() > 0 && d.key.size() <= 1000 && optRef(d, 'categoryId') &&
             (!('ownTransfer' in d) || d.ownTransfer is bool) &&
             (!('alias' in d) || (d.alias is string && d.alias.size() > 0 && d.alias.size() <= 60)) &&
             (!('askEachTime' in d) || d.askEachTime is bool);
    }

    function isValidMoneyDoc(collection, docId, d) {
      return hasValidVersion(d) && (
        (collection == 'cards' && isValidCard(d)) ||
        (collection == 'incomes' && isValidIncome(d)) ||
        (collection == 'fixedExpenses' && isValidFixedExpense(d)) ||
        (collection == 'subscriptions' && isValidSubscription(d)) ||
        (collection == 'variableBudgets' && isValidVariableBudget(d)) ||
        (collection == 'installments' && isValidInstallment(d)) ||
        (collection == 'periodicBudgets' && isValidPeriodicBudget(d)) ||
        (collection == 'debts' && isValidDebt(d)) ||
        (collection == 'savings' && isValidSaving(d)) ||
        (collection == 'assets' && isValidAsset(d)) ||
        (collection == 'categories' && isValidCategory(d)) ||
        (collection == 'goals' && isValidGoal(d)) ||
        (collection == 'donations' && isValidDonation(d)) ||
        (collection == 'tithe' && isValidTithe(docId, d)) ||
        (collection == 'closedMonths' && isValidClosedMonth(docId, d)) ||
        (collection == 'car' && isValidCar(docId, d)) ||
        (collection == 'pensionFunds' && isValidPensionFund(d)) ||
        (collection == 'transactions' && isValidTransaction(d)) ||
        (collection == 'merchantMemory' && isValidMerchantMemory(d))
      );
    }

    // --- Invites Collection (Join Flow) ---

    match /invites/{emailLower} {
      // Invitee can read only their own invite
      allow get: if isSignedIn() &&
                    request.auth.token.email != null &&
                    request.auth.token.email.lower() == emailLower;
      // Owner query must constrain householdId; needed to delete ALL outstanding invites.
      allow list: if isSignedIn() && isHouseholdMember(resource.data.householdId) &&
        get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.ownerUid == request.auth.uid;

      // Only the household owner can create or delete an invite
      allow create, update: if isSignedIn() &&
                               incoming().householdId is string &&
                               isHouseholdWritable(incoming().householdId) &&
                               get(/databases/$(database)/documents/households/$(incoming().householdId)).data.ownerUid == request.auth.uid;

      allow delete: if isSignedIn() && (
                       (request.auth.token.email != null && request.auth.token.email.lower() == emailLower) ||
                       (existing().householdId is string &&
                        isHouseholdMember(existing().householdId) &&
                        get(/databases/$(database)/documents/households/$(existing().householdId)).data.ownerUid == request.auth.uid)
                     );
    }

    // --- Households & Scoped Subcollections ---

    match /households/{householdId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(householdId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       isValidHousehold(incoming());

      allow update: if isSignedIn() &&
                       isValidId(householdId) &&
                       isValidHousehold(incoming()) && existing().get('deleting', false) == false && (
                         // Owner may transfer only to an existing member, optionally leaving atomically.
                         (existing().ownerUid == request.auth.uid && (
                           (incoming().ownerUid == existing().ownerUid &&
                            incoming().ownerUid in incoming().memberUids) ||
                           (incoming().ownerUid in existing().memberUids &&
                            incoming().ownerUid in incoming().memberUids &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                              ['ownerUid', 'ownerEmail', 'memberUids', 'partnerUid', 'partnerEmail']) &&
                            (incoming().memberUids == existing().memberUids ||
                             incoming().memberUids == existing().memberUids.removeAll([request.auth.uid])) &&
                            incoming().get('ownerEmail', '') ==
                              (incoming().ownerUid == existing().get('partnerUid', '') ? existing().get('partnerEmail', '') : '') &&
                            (request.auth.uid in incoming().memberUids
                              ? incoming().get('partnerUid', '') == request.auth.uid &&
                                incoming().get('partnerEmail', '') == existing().get('ownerEmail', '')
                              : (incoming().memberUids.size() == 1
                                ? incoming().get('partnerUid', '') == '' && incoming().get('partnerEmail', '') == ''
                                : incoming().get('partnerUid', '') in incoming().memberUids &&
                                  incoming().get('partnerUid', '') != incoming().ownerUid &&
                                  incoming().get('partnerEmail', '') == '')))
                         )) ||
                         // Members may leave themselves, never remove somebody else or take ownership.
                         (
                           request.auth.uid in existing().memberUids &&
                           existing().ownerUid != request.auth.uid &&
                           incoming().ownerUid == existing().ownerUid &&
                           incoming().get('deleting', false) == existing().get('deleting', false) &&
                           incoming().get('ownerEmail', '') == existing().get('ownerEmail', '') &&
                           (
                             (incoming().memberUids == existing().memberUids &&
                              incoming().get('partnerEmail', '') == existing().get('partnerEmail', '') &&
                              incoming().get('partnerUid', '') == existing().get('partnerUid', '')) ||
                             (incoming().memberUids == existing().memberUids.removeAll([request.auth.uid]) &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                                ['memberUids', 'partnerUid', 'partnerEmail']) &&
                              (existing().get('partnerUid', '') == request.auth.uid
                                ? ((incoming().get('partnerUid', '') == '' && incoming().get('partnerEmail', '') == '') ||
                                   (incoming().get('partnerUid', '') == existing().get('partnerUid', '') && incoming().get('partnerEmail', '') == existing().get('partnerEmail', '')))
                                : incoming().get('partnerUid', '') == existing().get('partnerUid', '') &&
                                  incoming().get('partnerEmail', '') == existing().get('partnerEmail', '')))
                           )
                         ) ||
                         // 3. Join flow: invitee can only add their uid to memberUids and set partnerUid,
                         //    requiring an existing invite for caller to this householdId
                         (
                           request.auth.token.email != null &&
                           exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())) &&
                           get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.householdId == householdId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'partnerUid']) &&
                           incoming().memberUids == existing().memberUids.concat([request.auth.uid]) &&
                           incoming().get('partnerUid', '') == request.auth.uid
                         )
                       );

      allow delete: if isSignedIn() && existing().ownerUid == request.auth.uid;

      // Subcollection: Tasks scoped to household
      match /tasks/{taskId} {
        allow get, list: if isHouseholdMember(householdId);
        allow create: if isHouseholdWritable(householdId) && isValidId(taskId) && isValidTaskItem(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isHouseholdWritable(householdId) && isValidId(taskId) && isValidTaskItem(incoming()) && incoming().userId == existing().userId;
        allow delete: if isHouseholdMember(householdId) && isValidId(taskId);
      }

      // Subcollection: Dreams scoped to household
      match /dreams/{dreamId} {
        allow get, list: if isHouseholdMember(householdId);
        allow create: if isHouseholdWritable(householdId) && isValidId(dreamId) && isValidDreamItem(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isHouseholdWritable(householdId) && isValidId(dreamId) && isValidDreamItem(incoming()) && incoming().userId == existing().userId;
        allow delete: if isHouseholdMember(householdId) && isValidId(dreamId);
      }

      // Subcollections: money (cards, items, budgets, debts, savings, assets, categories,
      // imported transactions and the merchant memory)
      match /{moneyCollection}/{docId} {
        allow get, list: if isMoneyCollection(moneyCollection) && isHouseholdMember(householdId);
        allow create, update: if isMoneyCollection(moneyCollection) && isHouseholdWritable(householdId) &&
                                 isValidId(docId) && isValidMoneyDoc(moneyCollection, docId, incoming());
        allow delete: if isMoneyCollection(moneyCollection) && isHouseholdMember(householdId) && isValidId(docId);
      }

      // Subcollection: Inbox scoped to household
      match /inbox/{itemId} {
        allow get, list: if isHouseholdMember(householdId);
        allow create: if isHouseholdWritable(householdId) && isValidId(itemId) && isValidInboxItem(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isHouseholdWritable(householdId) && isValidId(itemId) && isValidInboxItem(incoming()) && incoming().userId == existing().userId;
        allow delete: if isHouseholdMember(householdId) && isValidId(itemId);
      }
    }

    // --- Users: Fitness Logs & Private Subcollections ---

    match /users/{userId} {
      // Fitness logs: personal to user
      match /fitness/{logId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidFitnessLog(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidFitnessLog(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(logId);
      }

      // Private items (isPrivate = true): isolated from household queries
      match /private/{document=**} {
        allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Calculator Sync (Preserved/Legacy) ---

    match /calculator_sync/{syncId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Retired collection: no client creates or updates.
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
